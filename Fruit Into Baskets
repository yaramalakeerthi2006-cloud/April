class Solution:
    def totalFruit(self, s: List[int]) -> int:
        n=len(s)
        maxlen=0
        left=0
        right=0
        d={}
        while(right<n):
            if(s[right] in d):
                d[s[right]]+=1
            else:
                d[s[right]]=1
            while(len(d)>2):
                d[s[left]]-=1
                if(d[s[left]]==0):
                    del d[s[left]]
                left+=1
            maxlen=max(maxlen,right-left+1)
            right+=1
        return maxlen
